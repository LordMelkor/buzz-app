{
  "id": "buzz.codex",
  "name": "Codex",
  "apiVersion": 1,
  "description": "Run local Codex coding agents in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["Essentials", "code", "coding-agents"]
  },
  "host": {
    "mcp": true,
    "networkOrigins": [
      "https://releases.openai.com",
      "https://chatgpt.com",
      "https://persistent.oaistatic.com"
    ],
    "files": true,
    "processes": [
      {
        "id": "read-protected",
        "program": "buzz-agent-command",
        "bundled": true,
        "args": [
          "--shell",
          "case \"$1\" in \"~/\"*) set -- \"$HOME/${1:2}\";; esac; exec /usr/bin/base64 -i \"$1\"",
          "buzz-read"
        ]
      },
      {
        "id": "workspace",
        "program": "pwd"
      },
      {
        "id": "codex-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      { "id": "size", "program": "wc", "args": ["-c"] },
      {
        "id": "read-page",
        "program": "bash",
        "args": [
          "-c",
          "set -o pipefail; dd if=\"$1\" bs=1048576 skip=\"$2\" count=\"$3\" | base64",
          "buzz-read-page"
        ]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ]
  }
}
